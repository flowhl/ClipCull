<Window x:Class="ClipCull.Controls.StorageInfoEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Edit Storage Info (info.xml)"
        Height="470" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource ForegroundBrush}"
        FontFamily="{StaticResource FontSans}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Storage Info" Style="{StaticResource h3}" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="1" Style="{StaticResource muted}" TextWrapping="Wrap" Margin="0,0,0,12"
                   Text="Saved as info.xml at the chosen folder/card root. It auto-prefills the import metadata form whenever you scan from that location."/>

        <!-- Target folder -->
        <TextBlock Grid.Row="2" Text="Folder / card root" Style="{StaticResource small}" Margin="0,0,0,4"/>
        <Grid Grid.Row="3" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="FolderTextBox" Grid.Column="0" Style="{StaticResource input}" IsReadOnly="True"/>
            <Button Grid.Column="1" Content="Browse" Click="Browse_Click" Style="{StaticResource secondary}" Margin="8,0,0,0"/>
        </Grid>

        <StackPanel Grid.Row="4" Margin="0,0,0,8">
            <TextBlock Text="Camera / device model" Style="{StaticResource small}" Margin="0,0,0,4"/>
            <TextBox x:Name="CameraTextBox" Style="{StaticResource input}"/>
        </StackPanel>

        <StackPanel Grid.Row="5" Margin="0,0,0,8">
            <TextBlock Text="Reel" Style="{StaticResource small}" Margin="0,0,0,4"/>
            <TextBox x:Name="ReelTextBox" Style="{StaticResource input}"/>
        </StackPanel>

        <StackPanel Grid.Row="6" Margin="0,0,0,8">
            <TextBlock Text="Author" Style="{StaticResource small}" Margin="0,0,0,4"/>
            <TextBox x:Name="AuthorTextBox" Style="{StaticResource input}"/>
        </StackPanel>

        <StackPanel Grid.Row="7" Margin="0,0,0,8">
            <TextBlock Text="Location" Style="{StaticResource small}" Margin="0,0,0,4"/>
            <TextBox x:Name="LocationTextBox" Style="{StaticResource input}"/>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="9" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click" Style="{StaticResource secondary}" Margin="0,0,8,0"/>
            <Button x:Name="SaveButton" Content="Save info.xml" Click="Save_Click" Style="{StaticResource primary}" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
