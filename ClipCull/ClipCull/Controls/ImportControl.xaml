<UserControl x:Class="ClipCull.Controls.ImportControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ClipCull.Controls"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1300"
             x:Name="Root">

    <UserControl.Resources>
        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="{StaticResource SecondaryBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource MutedForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Dark-themed DatePicker text area -->
        <Style TargetType="{x:Type DatePickerTextBox}">
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
            <Setter Property="Background" Value="{StaticResource InputBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource ForegroundBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type DatePickerTextBox}">
                        <Border Background="{TemplateBinding Background}">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"
                                          Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type DatePicker}">
            <Setter Property="Background" Value="{StaticResource InputBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Row template for the import grid -->
        <DataTemplate x:Key="ThumbCell">
            <Border Width="64" Height="40" Background="{StaticResource MutedBrush}" CornerRadius="3">
                <Grid>
                    <materialDesign:PackIcon Kind="Image" Width="18" Height="18"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"
                                             Foreground="{StaticResource MutedForegroundBrush}"/>
                    <Image Source="{Binding ThumbnailPath}" Stretch="UniformToFill"
                           RenderOptions.BitmapScalingMode="LowQuality"/>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Border Style="{StaticResource card}" Padding="0" Margin="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- header -->
                <RowDefinition Height="Auto"/>
                <!-- source/target -->
                <RowDefinition Height="*"/>
                <!-- body -->
                <RowDefinition Height="Auto"/>
                <!-- status -->
            </Grid.RowDefinitions>

            <!-- ============ HEADER ============ -->
            <Border Grid.Row="0" Background="{StaticResource SecondaryBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                    Padding="16,12" CornerRadius="8,8,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="Import" Width="22" Height="22"
                                                 Foreground="{StaticResource ForegroundBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <StackPanel>
                            <TextBlock Text="Import" Style="{StaticResource h4}"/>
                            <TextBlock Text="Copy footage off a card and organize it into your library"
                                       Style="{StaticResource muted}" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Mode toggle -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ToggleButton x:Name="VideoModeToggle" Content="Video" Width="100"
                                      Style="{StaticResource secondary-toggle}" IsChecked="True"
                                      Click="VideoModeToggle_Click" Margin="0,0,8,0"/>
                        <ToggleButton x:Name="PhotoModeToggle" Content="Photo" Width="100"
                                      Style="{StaticResource secondary-toggle}"
                                      Click="PhotoModeToggle_Click"/>
                    </StackPanel>

                    <Button Grid.Column="2" Content="Edit storage info" Click="EditStorageInfo_Click"
                            Style="{StaticResource secondary}"/>
                </Grid>
            </Border>

            <!-- ============ SOURCE / TARGET ============ -->
            <StackPanel Grid.Row="1" Margin="16,12,16,4">
                <CheckBox x:Name="ReorganizeCheck" Content="Reorganize in place (sort this folder into dated subfolders — source and target are the same)"
                          Click="ReorganizeCheck_Changed" Margin="0,0,0,8"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Source (folder or drive)" Style="{StaticResource small}" Margin="0,0,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="SourceTextBox" Grid.Column="0" Style="{StaticResource input}" IsReadOnly="True"/>
                            <Button Grid.Column="1" Content="Browse" Click="BrowseSource_Click" Style="{StaticResource secondary}" Margin="8,0,0,0"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock x:Name="TargetLabel" Text="Target (library folder)" Style="{StaticResource small}" Margin="0,0,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TargetTextBox" Grid.Column="0" Style="{StaticResource input}" IsReadOnly="True"/>
                            <Button x:Name="TargetBrowseButton" Grid.Column="1" Content="Browse" Click="BrowseTarget_Click" Style="{StaticResource secondary}" Margin="8,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- ============ BODY ============ -->
            <Grid Grid.Row="2" Margin="16,8,16,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="360"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT: selection toolbar + grid -->
                <Grid Grid.Column="0" Margin="0,0,8,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Selection toolbar -->
                    <Border Grid.Row="0" Background="{StaticResource SecondaryBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6"
                            Padding="8" Margin="0,0,0,6">
                        <WrapPanel Orientation="Horizontal">
                            <Button Content="Select all" Click="SelectAll_Click" Style="{StaticResource secondary-sm}" Margin="0,0,6,0"/>
                            <Button Content="Deselect all" Click="DeselectAll_Click" Style="{StaticResource secondary-sm}" Margin="0,0,16,0"/>

                            <TextBlock Text="From" Style="{StaticResource small}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <DatePicker x:Name="RangeFromPicker" Width="130" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="To" Style="{StaticResource small}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <DatePicker x:Name="RangeToPicker" Width="130" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <Button Content="Select range" Click="SelectRange_Click" Style="{StaticResource secondary-sm}" Margin="0,0,6,0"/>
                            <Button Content="Deselect range" Click="DeselectRange_Click" Style="{StaticResource secondary-sm}"/>
                        </WrapPanel>
                    </Border>

                    <!-- Grid -->
                    <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                        <Grid>
                            <ListView x:Name="FilesListView"
                                      Background="Transparent" BorderThickness="0"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Width="40">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="" Width="76" CellTemplate="{StaticResource ThumbCell}"/>
                                        <GridViewColumn Header="Name" Width="200">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis"
                                                               Foreground="{StaticResource ForegroundBrush}" VerticalAlignment="Center"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Folder" Width="130">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding RelativeSubPath}" TextTrimming="CharacterEllipsis"
                                                               Foreground="{StaticResource MutedForegroundBrush}" VerticalAlignment="Center"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Size" Width="80">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding SizeDisplay}" Foreground="{StaticResource MutedForegroundBrush}"
                                                               FontFamily="{StaticResource FontMono}" FontSize="12" VerticalAlignment="Center"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Created" Width="120">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding CreatedDisplay}" Foreground="{StaticResource MutedForegroundBrush}"
                                                               FontFamily="{StaticResource FontMono}" FontSize="12" VerticalAlignment="Center"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Modified" Width="120">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding ModifiedDisplay}" Foreground="{StaticResource MutedForegroundBrush}"
                                                               FontFamily="{StaticResource FontMono}" FontSize="12" VerticalAlignment="Center"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Duration" Width="80">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding DurationDisplay}" Foreground="{StaticResource MutedForegroundBrush}"
                                                               FontFamily="{StaticResource FontMono}" FontSize="12" VerticalAlignment="Center"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Resolution" Width="90">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Resolution}" Foreground="{StaticResource MutedForegroundBrush}"
                                                               FontFamily="{StaticResource FontMono}" FontSize="12" VerticalAlignment="Center"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Conflict" Width="220">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal"
                                                                Visibility="{Binding HasConflict, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <Border Background="{StaticResource DestructiveBrush}" CornerRadius="3" Padding="5,1" VerticalAlignment="Center" Margin="0,0,6,0">
                                                            <TextBlock Text="{Binding ConflictSummary}" Foreground="White" FontSize="11"/>
                                                        </Border>
                                                        <ComboBox ItemsSource="{Binding AvailableResolutions}"
                                                                  SelectedItem="{Binding ConflictResolutionChoice, Mode=TwoWay}"
                                                                  MinWidth="120" VerticalAlignment="Center"
                                                                  ToolTip="{Binding ConflictExistingPath}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>

                            <!-- Empty / loading overlay -->
                            <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                <materialDesign:PackIcon Kind="FolderSearch" Width="48" Height="48"
                                                         Foreground="{StaticResource MutedForegroundBrush}" HorizontalAlignment="Center" Opacity="0.5"/>
                                <TextBlock x:Name="EmptyLabel" Text="Choose a source to scan for media"
                                           Style="{StaticResource muted}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- RIGHT: options -->
                <Border Grid.Column="1" Background="{StaticResource SecondaryBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="14">
                            <StackPanel>
                                <TextBlock Text="Organize" Style="{StaticResource h4}" Margin="0,0,0,10"/>

                                <TextBlock Text="Folder structure" Style="{StaticResource small}" Margin="0,0,0,4"/>
                                <ComboBox x:Name="StructureCombo" SelectionChanged="Options_Changed" Margin="0,0,0,10">
                                    <ComboBoxItem Content="All in the same folder"/>
                                    <ComboBoxItem Content="Subfolder per day"/>
                                    <ComboBoxItem Content="Subfolder per week"/>
                                    <ComboBoxItem Content="Subfolder per month"/>
                                </ComboBox>

                                <TextBlock Text="Date basis" Style="{StaticResource small}" Margin="0,0,0,4"/>
                                <ComboBox x:Name="DateBasisCombo" SelectionChanged="Options_Changed" Margin="0,0,0,10">
                                    <ComboBoxItem Content="Created date"/>
                                    <ComboBoxItem Content="Modified date"/>
                                </ComboBox>

                                <TextBlock x:Name="DateFormatLabel" Text="Day folder format" Style="{StaticResource small}" Margin="0,0,0,4"/>
                                <ComboBox x:Name="DateFormatCombo" IsEditable="True" SelectionChanged="Options_Changed"
                                          LostFocus="Options_Changed" Margin="0,0,0,6"/>
                                <TextBlock x:Name="DateFormatPreview" Style="{StaticResource muted}" FontSize="11" Margin="0,0,0,16"/>

                                <!-- Metadata (video only) -->
                                <StackPanel x:Name="MetadataPanel">
                                    <TextBlock Text="Metadata (written to sidecars)" Style="{StaticResource h4}" Margin="0,0,0,4"/>
                                    <TextBlock Text="Applied to every imported clip. Rating is never set here." Style="{StaticResource muted}" FontSize="11" Margin="0,0,0,10"/>

                                    <TextBlock Text="Author" Style="{StaticResource small}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="MetaAuthor" Style="{StaticResource input}" Margin="0,0,0,8"/>
                                    <TextBlock Text="Location" Style="{StaticResource small}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="MetaLocation" Style="{StaticResource input}" Margin="0,0,0,8"/>
                                    <TextBlock Text="Reel" Style="{StaticResource small}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="MetaReel" Style="{StaticResource input}" Margin="0,0,0,8"/>
                                    <TextBlock Text="Shot" Style="{StaticResource small}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="MetaShot" Style="{StaticResource input}" Margin="0,0,0,8"/>
                                    <TextBlock Text="Camera" Style="{StaticResource small}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="MetaCamera" Style="{StaticResource input}" Margin="0,0,0,8"/>
                                    <TextBlock Text="Description" Style="{StaticResource small}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="MetaDescription" Style="{StaticResource input}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="52" Margin="0,0,0,8"/>

                                    <TextBlock Text="Tags" Style="{StaticResource small}" Margin="0,0,0,4"/>
                                    <local:TaggingControl x:Name="TagControl" Background="Transparent"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14,10">
                            <StackPanel>
                                <TextBlock x:Name="SelectionSummary" Style="{StaticResource small}"
                                           Foreground="{StaticResource MutedForegroundBrush}" Margin="0,0,0,8"/>
                                <Button x:Name="ImportButton" Content="Import…" Click="Import_Click"
                                        Style="{StaticResource primary-lg}" HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- ============ STATUS ============ -->
            <Border Grid.Row="3" Background="{StaticResource SecondaryBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                    Padding="16,8" CornerRadius="0,0,8,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusLabel" Grid.Column="0" Text="Ready" Style="{StaticResource small}"
                               Foreground="{StaticResource MutedForegroundBrush}" VerticalAlignment="Center"/>
                    <ProgressBar x:Name="ProgressBarControl" Grid.Column="1" Width="220" Height="6"
                                 Foreground="{StaticResource AccentBrush}" Visibility="Collapsed" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
